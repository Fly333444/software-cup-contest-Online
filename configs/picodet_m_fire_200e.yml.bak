# PicoDet-M training config for Fire Detection Competition
# 3 classes: battery, board, fire
# Larger model (LCNet 1.5x) at 416x416 for better FPS + F1 balance
# Enhanced augmentation (Mosaic) for small dataset generalization
# Uses COCO-pretrained PicoDet-M weights for transfer learning

_BASE_: [
  '../PaddleDetection/configs/datasets/coco_detection.yml',
  '../PaddleDetection/configs/runtime.yml',
  '../PaddleDetection/configs/picodet/_base_/picodet_v2.yml',
  '../PaddleDetection/configs/picodet/_base_/optimizer_300e.yml',
]

# ======== Dataset ========
metric: COCO
num_classes: 3

TrainDataset:
  name: COCODataSet
  image_dir: A_train/Image
  anno_path: A_train/train.json
  dataset_dir: .
  data_fields: ['image', 'gt_bbox', 'gt_class', 'is_crowd']
  allow_empty: true

EvalDataset:
  name: COCODataSet
  image_dir: A_train/Image
  anno_path: A_train/val.json
  dataset_dir: .
  allow_empty: true

TestDataset:
  name: ImageFolder
  anno_path: A_train/val.json
  dataset_dir: .

# ======== Model: PicoDet-M (LCNet 1.5x, LCPAN 128ch, PicoFeat 128ch 4convs) ========
# Uses full COCO-pretrained model for better initialization
pretrain_weights: https://paddledet.bj.bcebos.com/models/picodet_m_320_coco_lcnet.pdparams
weights: output/picodet_m_fire_200e/model_final
find_unused_parameters: True
use_ema: true
epoch: 200
snapshot_epoch: 10

PicoHeadV2:
  nms:
    name: MultiClassNMS
    nms_top_k: 1000
    keep_top_k: 100
    score_threshold: 0.025
    nms_threshold: 0.6

# ======== Learning rate (scaled for batch_size=8) ========
# Base LR 0.04 = 0.02 (S@640 bs=4) * (8/4) * (416/640) scaling
LearningRate:
  base_lr: 0.04
  schedulers:
    - name: CosineDecay
      max_epochs: 200
    - name: LinearWarmup
      start_factor: 0.1
      steps: 500

# ======== Reader: 416x416, wide multi-scale + GridMask ========
worker_num: 2

TrainReader:
  sample_transforms:
    - Decode: {}
    - RandomCrop: {}
    - RandomFlip: {prob: 0.5}
    - RandomDistort: {}
    - GridMask: {prob: 0.3, ratio: 0.5, use_h: true, use_w: true, rotate: 1, offset: false, mode: 1, upper_iter: 360000}
  batch_transforms:
    - BatchRandomResize: {target_size: [320, 352, 384, 416, 448, 480, 512, 544, 576], random_size: True, random_interp: True, keep_ratio: False}
    - NormalizeImage: {is_scale: true, mean: [0.485, 0.456, 0.406], std: [0.229, 0.224, 0.225]}
    - Permute: {}
    - PadGT: {}
  batch_size: 8
  shuffle: true
  drop_last: true
  use_shared_memory: true

EvalReader:
  sample_transforms:
    - Decode: {}
    - Resize: {interp: 2, target_size: [416, 416], keep_ratio: False}
    - NormalizeImage: {is_scale: true, mean: [0.485, 0.456, 0.406], std: [0.229, 0.224, 0.225]}
    - Permute: {}
  batch_size: 8

TestReader:
  inputs_def:
    image_shape: [1, 3, 416, 416]
  sample_transforms:
    - Decode: {}
    - Resize: {interp: 2, target_size: [416, 416], keep_ratio: False}
    - NormalizeImage: {is_scale: true, mean: [0.485, 0.456, 0.406], std: [0.229, 0.224, 0.225]}
    - Permute: {}
  batch_size: 1
